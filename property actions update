def offer_purchase(player, space):

    print(f"You landed on {space['name']}!")
    print(f"Purchase price: ${space['price']}")
    
    choice = input("Would you like to buy this property? (Yes/No): ")
    
    if choice.title() == "Yes": # If player choses the buy the property
    
        if player["money"] >= space["price"]: # If player's bankroll is more than the cost of the property
    
            player["money"] -= space["price"] # Cost of property is deducted from player's bankroll
            space["owner"] = player["name"] # Transfers ownership to player after purchase
            player["properties"].append(space)
    
            print(f"You purchased {space['name']}!")
            print(f"Balance: ${player['money']}")
                
        else: # If you can't afford the property
            print("You do not have sufficient funds!")

            raise_money(player, space["price"]) # Raising money to purchase property

            if player["money"] >= space["price"]: # If player has raised enough funds to now purchase property
                    choice = input("You now have sufficient funds! Buy property? (Yes/No): ")
            
                    if choice.title() == "Yes":

                        player["money"] -= space["price"] # Cost of property is deducted from player's bankroll
                        space["owner"] = player["name"] # Player is now owner of the property
                        player["properties"].append(space)

                        print(f"You purchased {space['name']}!")
                        print(f"Balance: ${player['money']}")

def raise_money(player, amount_needed): # Raising money to purchase purchase properties
    while player["money"] < amount_needed: # While player's bankroll doesn't match the amount needed for the purchase

        print("\nHow would you like to raise funds?")
        print("1. Mortgage Properties")
        print("2. Sell Houses and Hotels")
        print("3. Done")

        choice = input("> ")

        if choice == "1": # Raise money through mortgaging
            mortgage_property(player)

        elif choice == "2": # Raise money through selling houses
            sell_house(player)

        elif choice == "3": # Leaving while loop
            break

def pay_player(payer, receiver, amount):

    if player["money"] < amount:

        print(f"{payer['name']} cannot afford ${amount}!")

        raise_money(payer, amount)

        if payer["money"] < amount:
            print(f"{payer['name']} is bankrupt!")
            return False

    payer["money"] -= amount
    receiver["money"] += amount

    return True

def bankrupt(player, creditor=None):

    print(f"{player['name']} is bankrupt")

    if creditor is not None:

        for property in player["properties"]:
            property["owner"] = creditor["name"]

        creditor["properties"].extend(
            player["properties"]
        )

def find_owner(owner_name):
