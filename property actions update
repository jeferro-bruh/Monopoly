def draw_card(player, deck):

    card = random.choice(deck)

    print(card["text"])

    if "money" in card:
        player["money"] += card["money"]
        print(f"Balance: ${player['money']}")
    
    if "position" in card:
        player["position"] = card["position"]

def count_railroads(owner, board): # Tracks 
    count = 0

    for space in board:
        if (
            space["type"] == "railroad" and space["owner"] == owner
        ):
            count += 1

    return count

def count_utilities(owner, board):
    count = 0

    for space in board:
        if (
            space["type"] == "utility" and space["owner"] == owner
        ):
            count += 1

    return count

